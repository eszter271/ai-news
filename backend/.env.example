# 服务端口
PORT=3000
CORS_ORIGIN=http://localhost:5173

# 数据库：默认 SQLite（零依赖），生产可切 PostgreSQL
# SQLite: sqlite:./data/ai-news.db
# PostgreSQL: postgres://user:pass@host:5432/ai_news
DATABASE_URL=sqlite:./data/ai-news.db

# Redis：可选，未配置则使用内存验证码存储
REDIS_URL=

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-prod
JWT_EXPIRES_IN=7d

# 邮件 SMTP（生产用阿里云邮件推送/SendGrid，开发可用 Mailtrap）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI News <no-reply@ai-news.local>"

# 前端域名（用于邮件链接）
APP_URL=http://localhost:5173

# 验证码：开发期可设为固定值方便测试
# 设为非空字符串则使用该固定验证码（如 "123456"），跳过随机生成
DEV_FIXED_CODE=

# 资讯抓取
NEWSAPI_KEY=
LLM_API_KEY=
LLM_BASE_URL=

# 翻译：可选，配置后启用真实 LLM 翻译；不配置时使用【译】占位 stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
