{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noEmit": false,
    "strictPropertyInitialization": false,
    "declaration": false,
    "removeComments": true
  },
  "include": ["src/**/*"]
}
