{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI News",
  "version": "1.0.0",
  "identifier": "com.ainews.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ai-news/web dev",
    "beforeBuildCommand": "pnpm --filter @ai-news/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI News",
        "width": 380,
        "height": 560,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": false,
        "x": 24,
        "y": 80
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; media-src 'self' https:; connect-src 'self' http://localhost:3000 https://api.openai.com https://hn.algolia.com https://export.arxiv.org; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "autostart": {
      "macosExtraArgs": ["-a", "AI News"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "News",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "nsis": {
      "installMode": "currentUser",
      "languages": ["SimpChinese", "English"]
    }
  }
}
